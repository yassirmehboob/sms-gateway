DATABASE_URL=mariadb://gateway:gateway_dev@127.0.0.1:3306/gateway
PORT=3000
# Set to your PC's LAN IPv4 address for local phone testing.
HOST=127.0.0.1
# Management console binds only to localhost, separately from the phone API.
CMS_PORT=3001
# CloudLinux/Passenger: DEPLOYMENT_MODE=passenger disables the second listener.
DEPLOYMENT_MODE=local
# 0 for direct access. Use 1 only when every request passes through one trusted
# proxy that overwrites/appends the real client IP. Confirm topology with the host.
TRUST_PROXY_HOPS=0
# Public URL prefix, e.g. /sms-gateway. Empty for a dedicated subdomain.
APP_BASE_PATH=
# Opt in to remote CMS access at this exact HTTPS origin (no /sms-gateway suffix).
# Leave empty to retain localhost-only administration.
CMS_PUBLIC_ORIGIN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_ENCRYPTION_KEY=
# Used only by the explicit development seed command. At least 32 characters.
DEV_API_KEY=
# FCM is opt-in; the API and tests do not contact Firebase by default.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Prefer workload identity / Application Default Credentials in production.
# For local development, point to a protected service-account file outside this repo.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
